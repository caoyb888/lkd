# ───────────────────────────────────────────────────────────────
# 莱矿-档案管理系统 · 后端运行环境变量（生产）
#
# 用法:
#   sudo cp deploy/lkda.env.example /opt/lkda/lkda.env
#   sudo nano /opt/lkda/lkda.env        # 填入真实值
#   sudo chown lkda:lkda /opt/lkda/lkda.env
#   sudo chmod 600 /opt/lkda/lkda.env   # ★ 只有 lkda 可读，机密不外泄
#
# 这些变量被 application-prod.yml 的 ${...} 占位符读取。
# ───────────────────────────────────────────────────────────────

# ── SQL Server 数据库 ──────────────────────────────────────────
# 同机部署填 127.0.0.1；独立/云数据库填其地址
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=laikuang_archive
DB_USERNAME=lkda_app
DB_PASSWORD=请改成强密码

# ── 文件上传存储目录（Web 根目录之外，Nginx 只读代理）──────────
# 需与应用中文件存储配置一致；systemd 已授予该目录写权限
FILE_STORAGE_PATH=/data/lkda-uploads

# ── JVM 额外参数（可选，留空即用 systemd 单元里的默认）─────────
# JAVA_TOOL_OPTIONS=

# ── Spring 时区（可选）─────────────────────────────────────────
TZ=Asia/Shanghai
